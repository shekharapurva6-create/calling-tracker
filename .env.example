# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Two Authorized NexGenAi Admin Gmail Accounts
VITE_ADMIN_EMAIL_1=admin1@gmail.com
VITE_ADMIN_EMAIL_2=admin2@gmail.com

# Telephony API Configuration (for production VoIP integration)
TELEPHONY_API_KEY=your_telephony_api_key
TELEPHONY_API_SECRET=your_telephony_api_secret
TELEPHONY_WEBHOOK_SECRET=your_telephony_webhook_secret

# App Environment & Portal URL
VITE_APP_NAME=NexGenAi
VITE_APP_URL=https://nexgenai.in
VITE_ENABLE_MOCK_TELEPHONY=true

# Notification Settings - Transactional Email
EMAIL_API_KEY=your_email_api_key
EMAIL_FROM=notifications@nexgenai.in
EMAIL_FROM_NAME=NexGenAi

# Notification Settings - Official WhatsApp Business / Cloud API
WHATSAPP_API_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_PROVIDER=META_CLOUD_API

